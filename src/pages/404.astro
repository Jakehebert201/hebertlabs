---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="That page doesn't exist." noindex>
  <div class="shell--narrow">
    <div class="page-intro">
      <p class="kicker">404</p>
      <h1>That page isn't here</h1>
      <p class="lede">
        The link is either wrong or points at something from an older version
        of this site.
      </p>
    </div>
    <div class="field-actions">
      <a class="btn btn--primary" href="/calculators/">Go to the calculators</a>
      <a class="btn btn--quiet" href="/">Back to the start</a>
    </div>
  </div>
</BaseLayout>
